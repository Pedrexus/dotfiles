#!/usr/bin/env python3
import socket
import socketserver
import threading

LISTEN_HOST = "0.0.0.0"
LISTEN_PORT = 8080
TARGET_HOST = "10.203.0.2"
TARGET_PORT = 8080


class ProxyHandler(socketserver.BaseRequestHandler):
    def handle(self) -> None:
        upstream = socket.create_connection((TARGET_HOST, TARGET_PORT))

        def pump(src: socket.socket, dst: socket.socket) -> None:
            try:
                while True:
                    data = src.recv(65536)
                    if not data:
                        break
                    dst.sendall(data)
            finally:
                try:
                    dst.shutdown(socket.SHUT_WR)
                except OSError:
                    pass

        threads = [
            threading.Thread(target=pump, args=(self.request, upstream), daemon=True),
            threading.Thread(target=pump, args=(upstream, self.request), daemon=True),
        ]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join()


class ProxyServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True


with ProxyServer((LISTEN_HOST, LISTEN_PORT), ProxyHandler) as server:
    server.serve_forever()