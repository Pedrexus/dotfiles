{{ if eq .chezmoi.os "windows" -}}
# Keep pixi global's toolbox equal to .chezmoitemplates/pixi-global.toml. chezmoi runs this again
# whenever the rendered manifest or a recipe changes, so an edit is one `chezmoi apply` away.
# recipes: {{ range (glob (joinPath .chezmoi.sourceDir "recipes/*/recipe.yaml")) }}{{ include . | sha256sum | trunc 12 }} {{ end }}
$ErrorActionPreference = 'Stop'
$env:PIXI_HOME = Join-Path $HOME '.pixi'
$env:PATH = "$env:PIXI_HOME\bin;$env:PATH"
if (-not (Get-Command pixi -ErrorAction SilentlyContinue)) {
    Invoke-RestMethod https://pixi.sh/install.ps1 | Invoke-Expression
}

# zsh and tmux: MSYS2's builds, repackaged into a local channel beside conda-forge's MSYS2 ones.
$channel = Join-Path $HOME '.cache\dotfiles\channel'
pixi exec rattler-build build --recipe-dir '{{ joinPath .chezmoi.sourceDir "recipes" }}' `
    --output-dir $channel -c conda-forge --skip-existing all
if ($LASTEXITCODE) { throw 'building the MSYS2 packages failed' }

# The manifest is this repository's: refuse to overwrite environments it does not declare.
$manifest = Join-Path $env:PIXI_HOME 'manifests\pixi-global.toml'
New-Item -ItemType Directory -Force (Split-Path $manifest) | Out-Null
if (Test-Path $manifest) {
    $foreign = Select-String -Path $manifest -Pattern '^\[envs\.(?!(dotfiles|msys)[\].])'
    if ($foreign) { throw "$manifest declares environments these dotfiles do not; move them into .chezmoitemplates/pixi-global.toml first" }
}
$text = @'
{{ template "pixi-global.toml" . }}
'@
[IO.File]::WriteAllText($manifest, $text)
pixi global sync
if ($LASTEXITCODE) { throw 'pixi global sync failed' }

# MSYS finds the home through nsswitch rather than HOME: make it the Windows one, so zsh, chezmoi
# and every other program agree on ~.
$nsswitch = Join-Path $env:PIXI_HOME 'envs\msys\Library\etc\nsswitch.conf'
(Get-Content $nsswitch) -replace '^db_home:.*', 'db_home: windows' | Set-Content -Encoding ascii $nsswitch
{{ end -}}
