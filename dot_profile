# ~/.profile: login shells that are not zsh. bash takes everything from ~/.bashrc; a plain sh
# gets mainboard's workspace environment here (see ~/.zshenv).
[ -r "$HOME/.config/mainboard/path.sh" ] && . "$HOME/.config/mainboard/path.sh"

if [ -n "$BASH_VERSION" ] && [ -r "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
